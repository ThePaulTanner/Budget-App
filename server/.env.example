# Copy to `.env` next to docker-compose.yml. No secrets go in this file:
# the master key and Plaid credentials live in ./secrets/ (see the README).

# The user id and group id that own the data and secrets folders.
# On a Synology, check with: id <your admin user>
PUID=1026
PGID=100

TZ=America/Toronto
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=CA,US
BASE_CURRENCY=CAD

# After you run `tailscale funnel`, put the public address here:
# PUBLIC_WEBHOOK_URL=https://your-nas.your-tailnet.ts.net:8443/plaid/webhook
PUBLIC_WEBHOOK_URL=

SYNC_INTERVAL_MINUTES=60
